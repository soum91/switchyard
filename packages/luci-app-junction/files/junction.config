config junction 'main'
	option enabled '1'
	# balance: spread connections over every working source; failover: use the first working one
	option mode 'balance'
	option interval '5'
	# a source whose signal stays below this (dBm) for 3 checks is dropped
	option min_signal '-82'
	# a source losing more than this % of pings is dropped
	option max_loss '30'
	list target '1.1.1.1'
	list target '8.8.8.8'
	list target '9.9.9.9'
