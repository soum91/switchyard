#!/bin/sh /etc/rc.common
# Lights Out: re-applies the LED schedule at boot (after the stock LED setup at 96).
START=99
USE_PROCD=1

start_service() {
	/usr/sbin/lightsout cron
	/usr/sbin/lightsout apply
}

reload_service() {
	rm -f /tmp/lightsout.override
	start_service
}

service_triggers() {
	procd_add_reload_trigger lightsout
}
